# Your app in WordPlus Cloud (Apps → Add app), with http://localhost:3000 among its addresses.
WORDPLUS_SITE=
WORDPLUS_SECRET=
# Your own: openssl rand -hex 32. The same on every server of the app, kept as long as the app.
WORDPLUS_LOCAL_KEY=

# Postgres 15 or newer: its tables come from npm run db.
DATABASE_URL=postgres://team:team@127.0.0.1:5432/team

# Better Auth: a long random string (openssl rand -base64 32), and the address of the site.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# 1 for the demo: the ready-made colleagues of npm run seed in one click, and "How this page works" under each page.
TEAM_DEMO=1
